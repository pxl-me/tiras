<Window x:Class="Oscilloscope.Client.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:helpers="clr-namespace:Oscilloscope.Client.Ui.Helpers" 
        mc:Ignorable="d"
	    Title="Oscilloscope" Height="720" Width="1360">

    <Window.Resources>
        <!-- Simple indicators without converters -->
        <Style x:Key="BoolDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Fill" Value="#B22222"/>
            <Setter Property="Stroke" Value="#80000000"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Fill" Value="#5CB85C"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NoiseDot" TargetType="Ellipse" BasedOn="{StaticResource BoolDot}">
            <!--Default: no noise (green). When HasNoise=true -> orange-->
            <Setter Property="Fill" Value="#5CB85C"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Fill" Value="#F0AD4E"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--<Style x:Key="NoiseDetectedStyle" TargetType="Ellipse" BasedOn="{StaticResource BoolDot}">
                <Setter Property="Fill" Value="#5CB85C"/>
                -->
        <!--<Setter Property="FontWeight" Value="SemiBold"/>-->
        <!--
                <Style.Triggers>
                    -->
        <!-- Жовтий: є шум (але ще не cut) -->
        <!--
                    <DataTrigger Binding="{Binding HasNoise}" Value="True">
                        <Setter Property="Fill" Value="#F0AD4E"/>
                    </DataTrigger>

                    -->
        <!-- Червоний: cut on (пріоритет) -->
        <!--
                    <DataTrigger Binding="{Binding IsCutEnabled}" Value="True">
                        <Setter Property="Fill" Value="#B22222"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>-->

        <Style x:Key="NoiseDetectedStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Stroke" Value="#80000000"/>
            <Setter Property="StrokeThickness" Value="1"/>

            <!-- Default: зелений -->
            <Setter Property="Fill" Value="#5CB85C"/>

            <Style.Triggers>
                <!-- Жовтий: є шум (але ще не cut) -->
                <DataTrigger Binding="{Binding IsNoiseEnabled}" Value="True">
                    <Setter Property="Fill" Value="#F0AD4E"/>
                </DataTrigger>

                <!-- Червоний: cut on (пріоритет над шумом) -->
                <DataTrigger Binding="{Binding IsCutEnabled}" Value="True">
                    <Setter Property="Fill" Value="#B22222"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AnomalyDetectedFromFramesStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Stroke" Value="#80000000"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Fill" Value="#B22222"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding AnomalyDetected}" Value="True">
                    <Setter Property="Fill" Value="#5CB85C"/>
                </DataTrigger>
                <!--<DataTrigger Binding="{Binding IsCutEnabled}" Value="True">
                    <Setter Property="Fill" Value="#B22222"/>
                </DataTrigger>-->
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="73*"/>
            <ColumnDefinition Width="595*"/>
            <ColumnDefinition Width="668*"/>
        </Grid.ColumnDefinitions>

        <!-- AUTH -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Email:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Margin="8,0,16,0" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Column="2" Text="Password:" VerticalAlignment="Center"/>
                <!--<PasswordBox Grid.Column="3" Margin="8,0,16,0"
                    helpers:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>-->
                <PasswordBox Grid.Column="3" Margin="8,0,16,0"
                     helpers:PasswordBoxAssistant.BindPassword="True"
                     helpers:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay}" />
                <Button Grid.Column="4" Content="Login" Width="90" Margin="0,0,8,0" Command="{Binding LoginCommand}"/>
                <Button Grid.Column="5" Content="Register" Width="90" Command="{Binding RegisterCommand}"/>

                <!--<TextBlock Grid.Column="7" Text="{Binding AuthStatus}" VerticalAlignment="Center" HorizontalAlignment="Right"/>-->
                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Ellipse Style="{StaticResource BoolDot}" Tag="{Binding IsAuthenticated}"/>
                    <TextBlock Text="{Binding AuthStatus}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONNECTION + SIGNAL TYPE -->
        <Border Grid.Row="1" Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,10,82" Grid.ColumnSpan="2">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Ellipse Style="{StaticResource BoolDot}" Tag="{Binding IsConnected}"/>
                    <TextBlock Text="SignalR" VerticalAlignment="Center"/>
                </StackPanel>
                <!--<Button Content="Connect" Width="110" Margin="0,0,8,0" Command="{Binding ConnectCommand}"/>
                <Button Content="Disconnect" Width="110" Margin="0,0,16,0" Command="{Binding DisconnectCommand}"/>-->
                <Button Content="Connect" Width="110" Margin="0,0,8,0"
                    IsEnabled="{Binding CanConnect}"
                    Command="{Binding ConnectCommand}"/>

                <Button Content="Disconnect" Width="110" Margin="0,0,16,0"
                    IsEnabled="{Binding CanDisconnect}"
                    Command="{Binding DisconnectCommand}"/>


                <!--<TextBlock Text="Signal type:" VerticalAlignment="Center"/>
                <ComboBox Width="180" Margin="8,0,0,0"
                    ItemsSource="{Binding SignalTypes}"
                    SelectedItem="{Binding SelectedSignalType}"/>-->
                <TextBlock Text="Type:" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <ComboBox Width="180" Margin="8,0,0,0"
                    IsEnabled="{Binding CanChangeSignalType}"
                    ItemsSource="{Binding SignalTypes}"
                    SelectedItem="{Binding SelectedSignalType}"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,82">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Ellipse Style="{StaticResource BoolDot}" Tag="{Binding IsConnected}"/>
                    <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Ellipse Style="{StaticResource BoolDot}" Tag="{Binding IsServerRunning}"/>
                    <TextBlock Text="Server" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Ellipse Style="{StaticResource BoolDot}" Tag="{Binding IsEmulatorRunning}"/>
                    <TextBlock Text="Emulator" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Width="147">
                    <TextBlock Text=" " VerticalAlignment="Center" Width="159"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Ellipse Style="{StaticResource NoiseDetectedStyle}"/>
                    <TextBlock VerticalAlignment="Center" Text="Noise"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Ellipse Style="{StaticResource AnomalyDetectedFromFramesStyle}"/>
                    <TextBlock VerticalAlignment="Center" Text="Anomaly"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Mode:" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentMode}" Margin="6,0,0,0" Foreground="#666" VerticalAlignment="Center"/>
                </StackPanel>

                <!--<TextBlock Grid.Column="2" Text="Noise:" Margin="20,0,0,0" VerticalAlignment="Center"/>
	                <CheckBox Grid.Column="3" IsChecked="{Binding HasNoise}" IsEnabled="False" Margin="8,0,0,0" VerticalAlignment="Center"/>-->

                <!--<TextBlock Grid.Column="2"
                    Text="Noise detected:"
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3"
                    Text="●"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource NoiseDetectedStyle}"/>-->

            </WrapPanel>
        </Border>

        <!-- EXTERNAL APPS -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,54,0,30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!--<Button Content="Start Server" Width="130" Margin="0,0,8,0" Command="{Binding StartServerCommand}"/>
	                    <Button Content="Stop Server" Width="130" Margin="0,0,20,0" Command="{Binding StopServerCommand}"/>-->
                    <Ellipse Style="{StaticResource BoolDot}" Tag="{Binding IsServerRunning}"/>
                    <TextBlock Text="Server" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="Start" Width="90" Margin="0,0,8,0"
	                            IsEnabled="{Binding CanStartServer}"
	                            Command="{Binding StartServerCommand}"/>
                    <Button Content="Stop" Width="90" Margin="0,0,18,0"
	                            IsEnabled="{Binding CanStopServer}"
	                            Command="{Binding StopServerCommand}"/>
                </StackPanel>

                <!--<Button Content="Start Emulator" Width="150" Margin="0,0,8,0"
                        IsEnabled="{Binding IsAuthenticated}"
                        ToolTip="Потрібен JWT (Login/Register)"
                        Command="{Binding StartEmulatorCommand}"/>
                <Button Content="Stop Emulator" Width="150" Command="{Binding StopEmulatorCommand}"/>-->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource BoolDot}" Tag="{Binding IsEmulatorRunning}"/>
                    <TextBlock Text="Emulator" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="Start" Width="90" Margin="0,0,8,0"
	                            IsEnabled="{Binding CanStartEmulator}"
	                            ToolTip="Потрібен JWT (Login/Register)"
	                            Command="{Binding StartEmulatorCommand}"/>
                    <Button Content="Stop" Width="90" Margin="0,0,18,0"
	                            IsEnabled="{Binding CanStopEmulator}"
	                            Command="{Binding StopEmulatorCommand}"/>
                </StackPanel>

                <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Status" Width="90" Margin="0,0,10,0" Command="{Binding StatusCommand}"/>

                    <!--<Button Content="Noise On" Width="100" Margin="0,0,8,0" Command="{Binding NoiseOnCommand}"/>
                <Button Content="Noise Off" Width="100" Margin="0,0,8,0" Command="{Binding NoiseOffCommand}"/>
                <Button Content="Cut On" Width="90" Margin="0,0,8,0" Command="{Binding CutOnCommand}"/>
                <Button Content="Restore" Width="90" Margin="0,0,8,0" Command="{Binding RestoreCommand}"/>-->
                    <CheckBox Content="Noise"
	                        Margin="0,0,10,0"
	                        IsEnabled="{Binding IsNoiseToggleEnabled}"
	                        IsChecked="{Binding IsNoiseEnabled}"/>

                    <ToggleButton Content="Cut/Restore"
	                        Width="90"
	                        Margin="0,0,10,0"
	                        IsEnabled="{Binding CanSendCommands}"
	                        IsChecked="{Binding IsCutEnabled}"/>


                    <!--<Button Content="Help" Width="80" Margin="0,0,10,0" Command="{Binding HelpCommand}"/>
	                    <Button Content="Exit" Width="70" Margin="0,0,10,0" Command="{Binding ExitEmulatorCommand}"/>-->

                    <!--<TextBlock Text="{Binding ExternalAppsStatus}" VerticalAlignment="Center"/>
	                    <TextBlock Text="{Binding CurrentMode}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#666"/>-->
                </WrapPanel>
            </Grid>
        </Border>

        <!-- CHART -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,106,0,0" Grid.RowSpan="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,8">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="DarkRed"/>
                    <TextBlock Text="{Binding InfoMessage}" Foreground="#444"/>
                </StackPanel>

                <lvc:CartesianChart Grid.Row="1"
                                  Series="{Binding Series}"
                                  XAxes="{Binding XAxes}"
                                  YAxes="{Binding YAxes}"
                                  AnimationsSpeed="00:00:00" />
            </Grid>
        </Border>

    </Grid>
</Window>
